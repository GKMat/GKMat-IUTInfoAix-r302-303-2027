usecase "Choose Stage" as cs
usecase "Show Message" as sm
usecase "Close Door" as c
usecase "Open Door" as o
usecase "Move Elevator" as me
}
u--->ca
u--->cs
ca-[dashed]->sm :<<include>>
cs-[dashed]->sm :<<include>>
ca-[dashed]->o :<<include>>
